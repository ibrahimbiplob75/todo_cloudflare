// This is your Prisma schema file for Cloudflare D1
// D1 uses SQLite, so we use the sqlite provider

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  creator     Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Task {
  id             Int       @id @default(autoincrement())
  serial         Int?       @default(1) @map("serial")
  projectId      Int?      @map("project_id")
  projectMeetingId Int?    @map("project_meeting_id")
  parentTaskId   Int?      @map("parent_task_id")
  title          String
  description    String?
  priority       String    @default("mid") // low, mid, high, urgent
  taskStatus     String    @default("pending") @map("task_status") // pending, in_progress, completed, failed, hold
  progressPercent Int @default(0) @map("progress_percent")
  submissionDate DateTime? @map("submission_date")
  executionDate  DateTime? @map("execution_date")
  completionDate DateTime? @map("completion_date")
  targetDate DateTime? @map("target_date")
  totalDuration  Int?      @default(0) @map("total_duration") // Duration in minutes
  assignedTo     Int?      @map("assigned_to")
  comment        String?
  status         Int       @default(1) @map("status") // 1: active, 0: inactive
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Self-referential relationship
  parentTask     Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]    @relation("TaskSubtasks")

  @@map("tasks")
  @@index([projectId])
  @@index([projectMeetingId])
  @@index([assignedTo])
  @@index([taskStatus])
  @@index([priority])
  @@index([submissionDate])
  @@index([parentTaskId])
  @@index([assignedTo, taskStatus])
  @@index([taskStatus, submissionDate])
  @@index([projectId, taskStatus, submissionDate])
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  title       String
  date        DateTime
  description String?
  creator     Int
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("project_meetings")
  @@index([projectId])
  @@index([creator])
  @@index([date])
  @@index([slug])
}

// ==================== REVENUE MANAGEMENT ====================

model RevenueSettings {
  id                    Int      @id @default(autoincrement())
  quotationPercentage   Float    @default(2.0) @map("quotation_percentage")
  marketingPercentage   Float    @default(5.0) @map("marketing_percentage")
  graphicsPercentage    Float    @default(5.0) @map("graphics_percentage")
  clientHuntPercentage  Float    @default(5.0) @map("client_hunt_percentage")
  qaPercentage          Float    @default(8.0) @map("qa_percentage")
  secondaryPercentage   Float    @default(10.0) @map("secondary_percentage")
  corePercentage        Float    @default(25.0) @map("core_percentage")
  reservePercentage     Float    @default(40.0) @map("reserve_percentage")
  updatedBy             Int?     @map("updated_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("revenue_settings")
}

model ProjectRevenue {
  id          Int      @id @default(autoincrement())
  projectId   Int      @unique @map("project_id")
  totalAmount Float    @map("total_amount")
  expense     Float    @default(0.0)
  netRevenue  Float    @map("net_revenue")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  assignments RevenueAssignment[]
  history     RevenueHistory[]

  @@map("project_revenues")
  @@index([projectId])
}

model RevenueAssignment {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  projectRevenue  ProjectRevenue @relation(fields: [projectRevenueId], references: [id], onDelete: Cascade)
  projectRevenueId Int     @map("project_revenue_id")
  role            String   // quotation, marketing, graphics, client_hunt, qa, secondary, core
  isUnused        Boolean  @default(false) @map("is_unused") // If role not used, amount goes to reserve
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  members         RevenueMember[]

  @@map("revenue_assignments")
  @@index([projectId])
  @@index([projectRevenueId])
  @@unique([projectRevenueId, role])
}

model RevenueMember {
  id                  Int      @id @default(autoincrement())
  revenueAssignment   RevenueAssignment @relation(fields: [revenueAssignmentId], references: [id], onDelete: Cascade)
  revenueAssignmentId Int      @map("revenue_assignment_id")
  userId              Int      @map("user_id")
  sharePercentage     Float    @default(0.0) @map("share_percentage") // 0-100
  amountEarned        Float    @default(0.0) @map("amount_earned")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("revenue_members")
  @@index([revenueAssignmentId])
  @@index([userId])
}

model RevenueHistory {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  projectRevenue  ProjectRevenue @relation(fields: [projectRevenueId], references: [id], onDelete: Cascade)
  projectRevenueId Int     @map("project_revenue_id")
  changeType      String   // "amount_change", "expense_change", "assignment_change", "settings_change"
  oldData         String?  @map("old_data") // JSON string
  newData         String?  @map("new_data") // JSON string
  changedBy       Int      @map("changed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("revenue_history")
  @@index([projectId])
  @@index([projectRevenueId])
  @@index([createdAt])
}
